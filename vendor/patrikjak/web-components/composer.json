{
	"name": "patrikjak/web-components",
	"description": "Simple web components package for laravel apps",
	"minimum-stability": "stable",
	"license": "proprietary",
	"version": "1.2.0",
	"authors": [
		{
			"name": "Patrik Jakab"
		}
	],
    "type": "library",
    "autoload": {
        "psr-4": {
            "Patrikjak\\WebComponents\\": "src/",
            "Patrikjak\\WebComponents\\Tests\\": "tests/"
        }
    },
	"require": {
		"php": "^8.4",
        "laravel/framework": "^11.31.0"
    },
	"require-dev": {
		"orchestra/testbench": "^9.6",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5.2",
		"slevomat/coding-standard": "~8.0",
		"spatie/phpunit-snapshot-assertions": "^5.1",
		"larastan/larastan": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
